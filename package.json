{
  "name": "wp-woo-mcp",
  "version": "0.1.0",
  "description": "MCP server for WordPress and WooCommerce. Read-only by default, safe writes behind an explicit switch.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "wp-woo-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsc --watch",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wordpress",
    "woocommerce",
    "ai-agents"
  ],
  "author": "Ali Saleem (alisaleem252)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
